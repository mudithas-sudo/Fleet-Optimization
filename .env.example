# Copy to .env and fill in:  cp .env.example .env

# Gemini API key (AI Studio) — used by the ADK planner agent
GOOGLE_API_KEY=your-gemini-api-key

# Google Maps Platform key — served to the browser for Maps JS, and the
# fallback for server-side calls. Restrict it by HTTP referrer in production.
MAPS_API_KEY=your-maps-api-key

# Optional separate key for server-side calls (Routes API, Places API New).
# Use an IP-restricted key here; falls back to MAPS_API_KEY when unset.
# MAPS_SERVER_KEY=your-ip-restricted-server-key

# Gemini model for the planner agent
MODEL=gemini-3.5-flash-lite

# Model for the dispatch (parcel-batching) agent. Needs more reasoning than
# the planner: flash-lite strands batchable parcels; flash is recommended.
DISPATCH_MODEL=gemini-3.5-flash

# Set to 1 while the Maps key has no billing: Routes API calls are replaced by a
# straight-line fallback so the whole demo still works end-to-end.
FAKE_ROUTES=1

# Routing: TRAFFIC_AWARE (live traffic ETAs, default) or TRAFFIC_UNAWARE
ROUTING_PREF=TRAFFIC_AWARE

# Deviation alerting
DEVIATION_THRESHOLD_M=80
DEVIATION_CONSECUTIVE=3

PORT=8000
